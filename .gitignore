__pycache__/
*.pyc

# Machine-specific paths for tools/win/build.cmd. Never committed: it names
# folders on one person's disk and this repo is public.
tools/win/paths.cmd

# Build output of tools/build_preview.mjs. 2.7MB of inlined data and images;
# regenerate it rather than commit it.
preview.html
# Written by tools/test_links.mjs --record: what each destination returned
# when last checked. Machine-written, machine-read, and specific to when it
# ran - not something to review in a diff.
data/link-baseline.json

# Written by tools/build_face_sheet.mjs: a QA contact sheet of every race tile,
# regenerated from data/races/faces whenever it is wanted. A build artifact, and
# it would churn in a diff every time a tile is rebuilt.
tools/face-sheet.html
